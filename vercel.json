{
  "routes": [
    {
      "src": "^/brands/visgo\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/vsgo.html"
      }
    },
    {
      "src": "^/brands/brand-9fd517d8de\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/pelican.html"
      }
    },
    {
      "src": "^/brands/brand-63ad1e5419\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/fujifilm.html"
      }
    },
    {
      "src": "^/brands/progaff\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/pro-gaff.html"
      }
    },
    {
      "src": "^/brands/healingshield\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/healing-shield.html"
      }
    },
    {
      "src": "^/brands/yconion\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/yc-onion.html"
      }
    },
    {
      "src": "^/brands/brand-33f2578e39\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/lugbox.html"
      }
    },
    {
      "src": "^/rental\\.html$",
      "status": 308,
      "headers": {
        "Location": "/catalog.html?kind=rental"
      }
    },
    {
      "src": "^/brands/brand-1764b0442d\\.html$",
      "status": 308,
      "headers": {
        "Location": "/catalog.html"
      }
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/data/catalog/brands\\.json$",
      "headers": {
        "Access-Control-Allow-Origin": "https://nadaunspace.blogspot.com"
      },
      "continue": true
    },
    {
      "src": "^/_private(?:/.*)?$",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "^/server(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "order\\.nadaun\\.co"
        }
      ],
      "dest": "/admin.html"
    },
    {
      "src": "^/admin(?:\\.html)?$",
      "has": [
        {
          "type": "host",
          "value": "shop\\.nadaun\\.co"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://order.nadaun.co/"
      }
    },
    {
      "src": "^/(admin|orders)$",
      "status": 308,
      "headers": {
        "Location": "/$1.html"
      }
    },
    {
      "src": "/brand/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/data/catalog/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/data/gift/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "^/product/[^/]+/kpp-([^/]+)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/item.html?id=kpp-$1"
      }
    },
    {
      "src": "^/item\\.html$",
      "dest": "/api/product"
    },
    {
      "src": "^/brands/brand-cb8705572d\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/plthink.html"
      }
    },
    {
      "src": "^/gifts\\.html$",
      "dest": "/api/gifts"
    },
    {
      "src": "^/gift-item\\.html$",
      "dest": "/api/gift-product"
    },
    {
      "src": "^/search\\.html$",
      "dest": "/api/search"
    },
    {
      "src": "^/brands/crystal-prompter\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/crystalprompter.html"
      }
    },
    {
      "src": "^/brands/zgc\\.html$",
      "status": 308,
      "headers": {
        "Location": "/brands/zgcine.html"
      }
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/product.js": {
      "includeFiles": "{item.html,data/catalog/catalog.json,data/catalog/rental-details.json,assets/shop/rental-content.js}"
    },
    "api/orders.js": {
      "includeFiles": "{data/catalog/catalog.json,data/catalog/details/*.json,server/commerce/**}",
      "maxDuration": 60
    },
    "api/gifts.js": {
      "includeFiles": "{gifts.html,data/gift/catalog.json,server/gift-catalog.cjs}"
    },
    "api/gift-product.js": {
      "includeFiles": "{gift-item.html,data/gift/**,server/gift-catalog.cjs}"
    },
    "api/search.js": {
      "includeFiles": "{search.html,data/gift/catalog.json,data/catalog/catalog.json,server/gift-catalog.cjs,server/shop-search.cjs,assets/shop/rental-content.js}"
    },
    "api/inicis-return.js": {
      "includeFiles": "{data/catalog/catalog.json,data/catalog/details/*.json,server/commerce/**}",
      "maxDuration": 60
    },
    "api/commerce-jobs.js": {
      "includeFiles": "{data/catalog/catalog.json,data/catalog/details/*.json,server/commerce/**}",
      "maxDuration": 60
    }
  }
}
