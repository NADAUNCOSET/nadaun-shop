eab634209fce071d2dcbc17c8b7a1607312.png"]},"source_id":"2485"},"avx-2158":{"images":{"thumb":"https://www.avx.co.kr/data/goods/1/2025/03/2158_temp_17430645572596list1.png","main":["https://www.avx.co.kr/data/goods/1/2025/03/2158_temp_17430645572596view.png","https://www.avx.co.kr/data/goods/1/2025/03/2158_temp_17422819648306view.png","https://www.avx.co.kr/data/goods/1/2025/03/2158_temp_17422819651523view.png","https://www.avx.co.kr/data/goods/1/2025/03/2158_temp_17422819656109view.png"],"detail":["https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_156005c5baf40ff51a327f1c34f2975b1613032.jpg","https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_799bad5a3b514f096e69bbc4a7896cd91613032.jpg","https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_d0096ec6c83575373e3a21d129ff8fef1613082.jpg","https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_032b2cc936860b03048302d991c3498f1613122.jpg","https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_18e2999891374a475d0687ca9f989d831613162.jpg","https://www.avx.co.kr/data/editor/goods/1/2025/03/2158_fe5df232cafa4c4e0f1a0294418e56601613212.jpg"]},"source_id":"2158"}}
