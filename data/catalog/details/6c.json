com/RICOH/GR IV HDF/04.jpg","https://image.plthink.com/RICOH/GR IV HDF/05.jpg","https://image.plthink.com/RICOH/GF-2/01.jpg"]},"source_id":"1929762"},"plthink-1916284":{"description_text":"[[SmallRig] 스몰리그 케이지 미니 탑 핸들 SRHTS2756B] 1~3 영업일","images":{"thumb":"https://www.plthink.com/shopimages/plthink/0080840003613.jpg?1768539976","main":["https://www.plthink.com/shopimages/plthink/0080840003612.jpg?1768539976"],"detail":["https://image.plthink.com/SMALLRIG/SR2756/상세1.jpg"]},"source_id":"1916284"},"plthink-1930394":{"description_text":"[[TILTA] 틸타 소니 FZ100 듀얼 배터리 충전 케이스 SD카드 리더 보관] 1~3 영업일","images":{"thumb":"https://www.plthink.com/shopimages/plthink/0081120001943.jpg?1788831130","main":["https://www.plthink.com/shopimages/plthink/0081120001942.jpg?1788831130"],"detail":["https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/01.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/02.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/03.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/04.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/05.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/06.jpg","https://image.plthink.com/TILTA/TBC-ARC-FZ100-B/07.jpg","https://image.plthink.com/TILTA/ALL/Outro.jpg"]},"source_id":"1930394"},"plthink-1926593":{"description_text":"[[Ulanzi] 울란지 LM19 맥세이프 호환 LED 셀카 조명 화이트 스마트폰 유튜브 촬영] 1~3 영업일","images":{"thumb":"https://www.plthink.com/shopimages/plthink/0080070002923.jpg?1768271959","main":["https://www.plthink.com/shopimages/plthink/0080070002922.jpg?1768271959"],"detail":["https://image.plthink.com/ULANZI/ALL/intro.jpg","https://image.plthink.com/ULANZI/DESIGN/LM19/00.jpg","https://image.plthink.com/ULANZI/DESIGN/LM19/01.jpg","https://image.plthink.com/ULANZI/ALL/Outro.jpg"]},"source_id":"1926593"},"dji-official-6941565957092":{"description_text":"DJI 트리플 카메라 시스템 탑재한 소비자 카메라 드론. Hasselblad 카메라 및 듀얼 망원 카메라 4K/61fps 동영상 촬영 가능.\n\n4/3 CMOS Hasselblad 카메라\n듀얼 망원 카메라\n최대 비행시간 43분\n전방위 장애물 감지\n15km HD 동영상 전송\n\nDJI RC 1개, 추가 배터리 2개, 배터리 충전 허브 1개, ND 필터 세트 등 포함. 다양한 시나리오에서 활용 가능.\n\n1. ActiveTrack은 동영상 해상도 4K 이상 또는 프레임 속도 60fps 이상 설정에서 지원하지 않습니다.\n2. 실제 사용 가능한 저장 공간은 시스템 구성으로 인해 감소할 수 있습니다. 자세한 내용은 공식 DJI 웹사이트 Mavic 3 Pro 사양 페이지를 참조해주세요.\n3. 비행시간 측정 조건: 무풍 환경의 해수면에서 32.4km/h 일정한 속도로 Mavic 3 Pro 배터리 잔량이 0%가 될 때까지 비행. 데이터는 참조용으로만 사용해야 합니다. 비행 중 DJI Fly 앱의 RTH 알림 메시지에 주의해주세요.\n4. 12m/s 이상의 강풍, 눈, 비, 안개, 우박, 번개를 포함하는 악천후 조건에서는 기체를 사용하지 마세요. 기체를 해발 6000m 이상 고도에서 비행하면 안 됩니다. 온도가 -10°C 미만이거나 40°C 이상인 환경에서 기체를 비행하지 마세요. 자동차 또는 보트와 같은 움직이는 물체에서 이륙하지 마세요. 물이나 눈과 같이 빛을 반사하는 표면에 가깝게 비행하면 안 됩니다. 그렇지 않으면 비전 시스템이 제대로 작동하지 않을 수 있습니다. GNSS 신호가 약할 때는 적절한 조명 및 가시성을 갖춘 환경에서만 기체를 비행해야 합니다. 주변 조도가 낮을 경우, 비전 시스템이 비정상적으로 작동할 수도 있습니다. 전자기 간섭원 근처에서 비행하지 마세요. 일반적인 전자기 간섭원 예: 고압 송전선, 고압 통신소, 레이더 기지, 휴대폰 기지국, 방송 송신탑, Wi-Fi 핫스팟, 라우터, 블루투스 기기 등. 사막이나 해변에서 이륙할 때는 모래가 기체에 들어가지 않도록 주의해야 합니다. 군중을 피해 탁 트인 지역에서 기체를 비행하세요. 건물, 산, 나무는 GNSS 신호를 차단하고 내장 콤파스에 영향을 줄 수 있습니다.\n5. FCC 기준. 간섭이 없는 탁 트인 야외 환경에서 측정한 값. 복귀 비행 포함하지 않는 편도 비행의 최장 통신 범위에 대한 데이터. 비행 중 DJI Fly 앱 RTH 알림 메시지에 주의해주세요.\n6. DJI Goggles Integra 모션 콤보와 DJI Goggles 2 모션 콤보와 호환되며, 별도로 구매해야 합니다.","images":{"thumb":"https://se-cdn.djiits.com/tpc/uploads/spu/cover/d1d9bf23f4a7f5c1b8c9cf2c3dcfb1e9@origin.png","main":["https://se-cdn.djiits.com/tpc/uploads/spu/cover/d1d9bf23f4a7f5c1b8c9cf2c3dcfb1e9@origin.png","https://se-cdn.djiits.com/tpc/uploads/carousel/image/7121536b3fc214eea6c6bf31efa59f84@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/b30885ca2aa697a477aa4e3ab771300c@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/ec59da2dbdd977a466de90d33b9a1e7f@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/851f44e587a113d355301ffe5d8dd817@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/000bc1714d73291b3086af321da883a9@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/b1dcd044fde0d2732407e393edfe035d@origin.jpg","https://se-cdn.djiits.com/tpc/uploads/carousel/image/0791bd4e76213c365203b864942d794f@origin.jpg"],"detail":[]},"source_id":"137721"},"dji-official-EAN2025042301":{"description_text":"드론은 DJI Dock 3에 맞춰 특별히 설계되어 더 길어진 비행 시간과 IP55 등급의 방진 및 방수 기능을 제공합니다.\n\n더 길어진 비행, IP55 보호\n원활한 공중 릴레이\n안전성을 위한 장애물 감지\n효율성을 위한 자동 기능\n낮은 조도에서도 뛰어난 성능\n액세서리 업그레이드\n\n20MP 4/3 CMOS 광각 카메라, 미디엄 망원 카메라, 망원 카메라, 레이저 거리 측정기, 보상 적용 범위 내 2년간 무료 수리 제공.\n\n1. 통제된 테스트 환경에서 측정한 값. 테스트 측정 조건: 해발 20m 무풍 실험실 환경, 12 m/s 일정한 속도로 전진 비행, 사진 모드(비행 중 사진 촬영 작업 미진행), 장애물 회피 동작 꺼짐, 배터리 잔량 100%에서 0%까지 진행. 결과는 환경, 실제 사용법, 펌웨어 버전에 따라 다를 수 있습니다.\n2. 측정 조건: 해발 20m 무풍 환경, DJI Matrice 4D 시리즈 사용해 배터리 잔량 100%에서 0%까지 호버링 진행. 결과는 환경, 실제 사용법, 펌웨어 버전에 따라 다를 수 있습니다.\n3. DJI Matrice 4D/4TD는 IP55 등급입니다. 두 장비 측정 조건: 통제된 실험실 환경. IP 등급은 영구적인 것이 아니며 장기간 사용 후 제품 마손으로 저하될 수 있습니다.\n4. 별도 구매.\n5. 최신 펌웨어로 업그레이드해야 합니다.\n6. DJI Dock 2의 Matrice 3D/3TD와 비교하여 측정한 값.\n7. 일부 액세서리는 별도로 구매해야 합니다. 액세서리를 설치하면 기체의 장애물 회피 안전 성능에 영향을 줄 수 있습니다. 지침에 따라 사용하세요.","images":{"thumb":"https://se-cdn.djiits.com/tpc/uploads/spu_bundle/cover/78568b19f88fcc5a92eea18cf2c3bd4d@origin.png?format=webp","main":["https://se-cdn.djiits.com/tpc/uploads/spu_bundle/cover/78568b19f88fcc5a92eea18cf2c3bd4d@origin.png?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/a190551aac82c77b387c89b644a43ffc@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/fce8bc099207b5832826abe0b223acd9@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/e42382cfc7e7ffc588bd1625ca1408b5@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/dd959cec5b6273fec02077ccb891f6be@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/dde73621c711390ccd20ab34c0aa7de8@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/770358baa602de916fd3183584a7a642@origin.jpg?format=webp","https://se-cdn.djiits.com/tpc/uploads/carousel/image/7877d546591b33a71cc43fb83ef6f9da@origin.jpg?format=webp"],"detail":[]},"source_id":"189141"}}
