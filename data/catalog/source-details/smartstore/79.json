        "https://shop-phinf.pstatic.net/20250526_74/1748240765671EwiWg_PNG/82373733777633242_230288634.png",
        "https://shop-phinf.pstatic.net/20250526_127/17482407925315uBk6_PNG/82373760656140754_140578249.png",
        "https://shop-phinf.pstatic.net/20250526_82/1748240792682CPMIT_PNG/82373760780984335_1586953650.png"
